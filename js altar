let marcoActualId = null;
let nombreActualId = null;

// Esperar a que el DOM cargue por completo
document.addEventListener('DOMContentLoaded', () => {
    const inputFoto = document.getElementById('input-foto');
    const botonesEditar = document.querySelectorAll('.btn-foto');

    // Escuchar el clic en cada botón de "Editar Foto"
    botonesEditar.forEach(boton => {
        boton.addEventListener('click', (e) => {
            marcoActualId = e.target.getAttribute('data-target');
            nombreActualId = e.target.getAttribute('data-name');
            
            // Pedir el nombre de la mascota
            const nombreMascota = prompt('Ingresa el nombre de tu mascota:');
            
            // Si el usuario ingresó un nombre, lo mostramos en la etiqueta
            if (nombreMascota !== null && nombreMascota.trim() !== '') {
                const elementoNombre = document.getElementById(nombreActualId);
                if (elementoNombre) {
                    elementoNombre.textContent = nombreMascota.trim();
                    elementoNombre.style.display = 'block';
                }
            }

            // Abrir selector de archivos de imagen
            inputFoto.click();
        });
    });

    // Cargar la imagen seleccionada cuando cambia el input de archivo
    inputFoto.addEventListener('change', (event) => {
        const archivo = event.target.files[0];
        if (archivo && marcoActualId) {
            const lector = new FileReader();
            lector.onload = function(e) {
                const imgElement = document.getElementById(marcoActualId);
                imgElement.src = e.target.result;
                imgElement.style.display = 'block';
            };
            lector.readAsDataURL(archivo);
        }
    });
});
